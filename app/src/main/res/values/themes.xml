<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SumCtrl" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>

    <!-- The "Calculate" pop-up: see-through, the dimmed backdrop and the card are drawn by the app. -->
    <style name="Theme.SumCtrl.Popup" parent="Theme.SumCtrl">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
